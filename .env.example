# Máy chủ FastBusiness truy cập từ Windows hoặc Android qua LAN/VPN.
# Đổi URL nếu máy chủ dùng địa chỉ hoặc cổng khác.
FASTBUSINESS_BASE_URL=http://192.168.2.62
FASTBUSINESS_DATABASE=TOANTRUNG_FBISP2421_A
FASTBUSINESS_UNIT=CTY
FASTBUSINESS_TIMEOUT=15
FASTBUSINESS_VERIFY_TLS=true

# Dữ liệu sản phẩm/báo giá do người dùng tạo được lưu trong SQLite cục bộ.
DB_PATH=bom_led.db
DEFAULT_VAT=8.0
DEFAULT_PROFIT=20.0
# Tuyệt đối không đặt USERNAME/PASSWORD hoặc cookie phiên vào .env.
